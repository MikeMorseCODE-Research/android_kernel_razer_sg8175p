					};

					vbat_cdsp0 {
						trip = <&b_bcl_lvl0>;
						cooling-device = <&cdsp_sw>, <0x02 0x02>;
					};
				};
			};

			pm8350b-bcl-lvl1 {

				cooling-maps {

					vbat_gpu1 {
						trip = <&b_bcl_lvl1>;
						cooling-device = <&msm_gpu>, <0x04 0x04>;
					};

					vbat_cpu6 {
						trip = <&b_bcl_lvl1>;
						cooling-device = <&cpu6_isolate>, <0x01 0x01>;
					};

					vbat_cpu7 {
						trip = <&b_bcl_lvl1>;
						cooling-device = <&cpu7_isolate>, <0x01 0x01>;
					};

					vbat_cdsp1 {
						trip = <&b_bcl_lvl1>;
						cooling-device = <&cdsp_sw>, <0x04 0x04>;
