				pinctrl-1 = <&cam_sensor_mclk5_suspend>, <&cam_sensor_suspend_rst5>;
				gpios = <&tlmm>, <0x69 0x00>, <&tlmm>, <0x73 0x00>;
				gpio-reset = <0x01>;
				gpio-req-tbl-num = <0x00 0x01>;
				gpio-req-tbl-flags = <0x01 0x00>;
				gpio-req-tbl-label = "CAMIF_MCLK5", "CAM_RESET5";
				cci-master = <0x01>;
				status = "ok";
				clocks = <&clock_camcc>, <0x58>;
				clock-names = "cam_clk";
				clock-cntl-level = "nominal";
				clock-rates = <0x124f800>;
				phandle = <0x74>;
			};

			qcom,cam-sensor0 {
				cell-index = <0x00>;
				compatible = "qcom,cam-sensor";
				csiphy-sd-index = <0x05>;
				sensor-position-roll = <0x10e>;
				sensor-position-pitch = <0x00>;
				sensor-position-yaw = <0x00>;
				eeprom-src = <&txd_hi556_eeprom>;
				cam_vio-supply = <&pm8008j_l3>;
				cam_vana-supply = <&pm8008j_l5>;
				cam_vdig-supply = <&pm8008j_l1>;
				cam_clk-supply = <&cam_cc_titan_top_gdsc>;
				cam_bob-supply = <&pm8350c_bob>;
				regulator-names = "cam_vio", "cam_vana", "cam_vdig", "cam_clk", "cam_bob";
				rgltr-cntrl-support;
				rgltr-min-voltage = <0x1b7740 0x2ab980 0x124f80 0x00 0x30d400>;
				rgltr-max-voltage = <0x1b7740 0x2ab980 0x124f80 0x00 0x3c6cc0>;
				rgltr-load-current = <0x1388 0x88b8 0x497c8 0x00 0x1e8480>;
				gpio-no-mux = <0x00>;
				pinctrl-names = "cam_default", "cam_suspend";
				pinctrl-0 = <&cam_sensor_mclk5_active>, <&cam_sensor_active_rst5>;
				pinctrl-1 = <&cam_sensor_mclk5_suspend>, <&cam_sensor_suspend_rst5>;
				gpios = <&tlmm>, <0x69 0x00>, <&tlmm>, <0x73 0x00>;
				gpio-reset = <0x01>;
				gpio-req-tbl-num = <0x00 0x01>;
				gpio-req-tbl-flags = <0x01 0x00>;
				gpio-req-tbl-label = "CAMIF_MCLK5", "CAM_RESET5";
				cci-master = <0x01>;
				status = "ok";
				clocks = <&clock_camcc>, <0x58>;
				clock-names = "cam_clk";
				clock-cntl-level = "nominal";
				clock-rates = <0x124f800>;
			};
		};
	};

