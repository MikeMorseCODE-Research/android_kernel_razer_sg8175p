					};

					pm8350_cpu7_freq {
						trip = <&pm8350_trip0>;
						cooling-device = <&CPU7>, <0xfffffffe 0xfffffffe>;
					};

					pm8350_cpu4 {
						trip = <&pm8350_trip0>;
						cooling-device = <&cpu4_isolate>, <0x01 0x01>;
					};

					pm8350_cpu5 {
						trip = <&pm8350_trip0>;
						cooling-device = <&cpu5_isolate>, <0x01 0x01>;
					};

					pm8350_cpu6 {
						trip = <&pm8350_trip0>;
						cooling-device = <&cpu6_isolate>, <0x01 0x01>;
					};

					pm8350_cpu7 {
						trip = <&pm8350_trip0>;
						cooling-device = <&cpu7_isolate>, <0x01 0x01>;
					};
				};
			};

			pm8350c_tz {

				cooling-maps {

					pm8350c_mdm {
						trip = <&pm8350c_trip0>;
						cooling-device = <&modem_tj>, <0xfffffffe 0xfffffffe>;
					};

					pm8350c_nsp {
						trip = <&pm8350c_trip0>;
						cooling-device = <&cdsp_sw>, <0xfffffffe 0xfffffffe>;
					};
				};
			};

			pmr735a_tz {

				cooling-maps {

					pmr735a_pa {
						trip = <&pmr735a_trip0>;
						cooling-device = <&modem_pa_dsc>, <0xfffffffe 0xfffffffe>;
					};

					pmr735a_pa_fr1 {
						trip = <&pmr735a_trip0>;
						cooling-device = <&modem_pa_fr1_dsc>, <0xfffffffe 0xfffffffe>;
					};

					pmr735a_mmw0 {
						trip = <&pmr735a_trip0>;
						cooling-device = <&modem_mmw0>, <0xfffffffe 0xfffffffe>;
					};

					pmr735a_mmw1 {
						trip = <&pmr735a_trip0>;
						cooling-device = <&modem_mmw1>, <0xfffffffe 0xfffffffe>;
					};

					pmr735a_mmw2 {
						trip = <&pmr735a_trip0>;
