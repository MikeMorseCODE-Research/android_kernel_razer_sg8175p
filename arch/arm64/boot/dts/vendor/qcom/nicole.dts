	fragment@98 {
		target = <&thermal_zones>;

		__overlay__ {

			cpu-1-6-step {

				trips {

					fan_cpu16_config0: fan-cpu16-config0 {
						temperature = <0x13880>;
						hysteresis = <0x1388>;
						type = "passive";
						phandle = <0x84>;
					};

					fan_cpu16_config1: fan-cpu16-config1 {
						temperature = <0x15f90>;
						hysteresis = <0x1388>;
						type = "passive";
						phandle = <0x86>;
					};

					fan_cpu16_config2: fan-cpu16-config2 {
						temperature = <0x17318>;
						hysteresis = <0x1388>;
						type = "passive";
						phandle = <0x87>;
					};
				};

				cooling-maps {

					fan_cdev_0 {
						trip = <&fan_cpu16_config0>;
						cooling-device = <&fancontroller>, <0x05 0x05>;
					};

					fan_cdev_1 {
						trip = <&fan_cpu16_config1>;
						cooling-device = <&fancontroller>, <0x06 0x06>;
					};

					fan_cdev_2 {
						trip = <&fan_cpu16_config2>;
						cooling-device = <&fancontroller>, <0x07 0x07>;
					};
				};
			};

			cpu-1-7-step {

				trips {

					fan_cpu17_config0: fan-cpu17-config0 {
						temperature = <0x13880>;
						hysteresis = <0x1388>;
						type = "passive";
						phandle = <0x88>;
					};

					fan_cpu17_config1: fan-cpu17-config1 {
						temperature = <0x15f90>;
						hysteresis = <0x1388>;
						type = "passive";
						phandle = <0x89>;
					};

					fan_cpu17_config2: fan-cpu17-config2 {
						temperature = <0x17318>;
						hysteresis = <0x1388>;
						type = "passive";
						phandle = <0x8a>;
					};
				};

				cooling-maps {

					fan_cdev_0 {
						trip = <&fan_cpu17_config0>;
						cooling-device = <&fancontroller>, <0x05 0x05>;
					};

					fan_cdev_1 {
