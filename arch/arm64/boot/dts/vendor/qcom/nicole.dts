	fragment@32 {
		target = <&tlmm>;

		__overlay__ {

			display_panel_avdd_default: display_panel_avdd_default {
				phandle = <0x07>;

				mux {
					pins = "gpio13";
					function = "gpio";
				};

				config {
					pins = "gpio13";
					drive-strength = <0x08>;
					bias-disable = <0x00>;
					output-low;
				};
			};
		};
	};

	fragment@33 {
		target = <&soc>;

		__overlay__ {

			display_panel_avdd: display_gpio_regulator@1 {
				compatible = "qti-regulator-fixed";
				regulator-name = "display_panel_avdd";
				regulator-min-microvolt = <0x53ec60>;
				regulator-max-microvolt = <0x53ec60>;
				regulator-enable-ramp-delay = <0xe9>;
				gpio = <&tlmm>, <0x0d 0x00>;
				regulator-boot-on;
				proxy-supply = <&display_panel_avdd>;
				qcom,proxy-consumer-enable;
				pinctrl-names = "default";
				pinctrl-0 = <&display_panel_avdd_default>;
				enable-active-low;
				phandle = <0x04>;
			};

			sde_wb: qcom,wb-display@0 {
				compatible = "qcom,wb-display";
				cell-index = <0x00>;
				label = "wb_display";
				phandle = <0x08>;
			};
		};
	};

	fragment@34 {
		target = <&mdss_mdp>;

		__overlay__ {
			connectors = <&smmu_sde_unsec>, <&smmu_sde_sec>, <&sde_dp>, <&sde_wb>, <&sde_dsi>, <&sde_dsi1>, <&sde_rscc>;
		};
	};

