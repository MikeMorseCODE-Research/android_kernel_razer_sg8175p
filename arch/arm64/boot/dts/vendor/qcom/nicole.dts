				pinctrl-1 = <&cdc_dmic01_clk_sleep>, <&cdc_dmic01_data_sleep>;
				qcom,lpi-gpios;
				qcom,tlmm-pins = <0xae 0xaf>;
				#gpio-cells = <0x00>;
