					vph_cdsp2 {
						trip = <&c_bcl_lvl2>;
						cooling-device = <&cdsp_sw>, <0xfffffffe 0xfffffffe>;
					};
				};
			};

			pm8350b_tz {

				cooling-maps {

					battery_cdev {
						trip = <&pm8350b_trip0>;
						cooling-device = <&battery_charger>, <0xfffffffe 0xfffffffe>;
