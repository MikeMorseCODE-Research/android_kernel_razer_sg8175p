					};

					pmr735a_mmw3 {
						trip = <&pmr735a_trip0>;
						cooling-device = <&modem_mmw3>, <0xfffffffe 0xfffffffe>;
					};
				};
			};

			xo-therm-step {

				cooling-maps {

					cpu4_freq_cdev {
						trip = <&xo_config0>;
						cooling-device = <&CPU4>, <0xfffffffe 0xfffffffe>;
					};

					cpu7_freq_cdev {
						trip = <&xo_config0>;
						cooling-device = <&CPU7>, <0xfffffffe 0xfffffffe>;
					};

					cpu4_iso_cdev {
						trip = <&xo_config0>;
						cooling-device = <&cpu4_isolate>, <0x01 0x01>;
					};

					cpu5_iso_cdev {
						trip = <&xo_config0>;
						cooling-device = <&cpu5_isolate>, <0x01 0x01>;
					};

					cpu6_iso_cdev {
						trip = <&xo_config0>;
						cooling-device = <&cpu6_isolate>, <0x01 0x01>;
					};

					cpu7_iso_cdev {
						trip = <&xo_config0>;
						cooling-device = <&cpu7_isolate>, <0x01 0x01>;
					};

					cpu4_hot_cdev {
						trip = <&xo_config1>;
