			reset-names = "core_reset";
		};
	};

	fragment@93 {
		target = <&tlmm>;

		__overlay__ {

			gpio_nc: gpio_nc_pin {
				phandle = <0x7d>;

				mux {
					pins = "gpio12", "gpio26", "gpio33";
					function = "gpio";
				};

				config {
					pins = "gpio12", "gpio26", "gpio33";
					bias-pull-down;
					drive-strength = <0x02>;
					input-enable;
				};
			};

			usb_ocp: usb_ocp_pin {
				phandle = <0x7b>;

				mux {
					pins = "gpio79";
					function = "gpio";
				};

				config {
					pins = "gpio79";
					bias-pull-up;
					drive-strength = <0x06>;
					input-enable;
				};
			};

			sim_gpio: sim_gpio_pin {
				phandle = <0x7c>;

				mux {
					pins = "gpio86";
					function = "gpio";
				};

				config {
					pins = "gpio86";
					bias-disable;
					drive-strength = <0x02>;
					input-enable;
				};
			};

			pmx_vib_active {

				vib_active: vib_active {
					phandle = <0x76>;

					mux {
						pins = "gpio106", "gpio44";
						function = "gpio";
					};

					config {
						pins = "gpio106", "gpio44";
						drive-strength = <0x08>;
						bias-pull-up;
					};
				};
			};

			pmx_vib_reset_suspend {

				vib_reset_suspend: vib_reset_suspend {
					phandle = <0x79>;

					mux {
						pins = "gpio106";
						function = "gpio";
					};

					config {
						pins = "gpio106";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};

			pmx_vib_int_suspend {

				vib_int_suspend: vib_int_suspend {
					phandle = <0x78>;

					mux {
						pins = "gpio44";
						function = "gpio";
					};

					config {
						pins = "gpio44";
						drive-strength = <0x02>;
						bias-pull-down;
					};
				};
			};

			pmx_vib_release {

				vib_release: vib_release {
					phandle = <0x7a>;

					mux {
						pins = "gpio106", "gpio44";
						function = "gpio";
					};

					config {
						pins = "gpio106", "gpio44";
						drive-strength = <0x02>;
						bias-disable;
					};
				};
			};

			pmx_vibhi_release {

				vibhi_release: vibhi_release {
					phandle = <0x77>;

					mux {
						pins = "gpio16", "gpio17";
						function = "gpio";
					};

					config {
						pins = "gpio16", "gpio17";
						bias-high-impedance;
					};
				};
			};

			fan: fan_pin {
				phandle = <0x7e>;

				mux {
					pins = "gpio8", "gpio9";
					function = "gpio";
				};

				config {
					pins = "gpio8", "gpio9";
					bias-pull-up;
					drive-strength = <0x10>;
				};
			};

			thundersoft_straps {

				sku_straps: sku_straps {
					phandle = <0x82>;

					mux {
						pins = "gpio3", "gpio6", "gpio7";
						function = "gpio";
					};

					config {
						pins = "gpio3", "gpio6", "gpio7";
						drive-strength = <0x02>;
						bias-pull-up;
						input-enable;
					};
				};

				board_rev_straps: board_rev_straps {
					phandle = <0x83>;

					mux {
						pins = "gpio45", "gpio50", "gpio51";
						function = "gpio";
					};

					config {
						pins = "gpio45", "gpio50", "gpio51";
						drive-strength = <0x02>;
						bias-pull-up;
						input-enable;
					};
				};
			};
		};
	};

	fragment@94 {
		target = <&soc>;

		__overlay__ {

			quectel,5g-module-ctrl {
				compatible = "quectel-module-ctrl";
				label = "quectel-5g-module-ctrl";
				full-card-power-off-gpio = <&tlmm>, <0x31 0x00>;
				module-reset-gpio = <&tlmm>, <0x74 0x00>;
			};

			qcom_ocp {
				compatible = "qcom,ocp-msm";
				interrupt-parent = <&tlmm>;
				interrupts = <0x4f 0x2008>;
				ocp,control-gpio = <&tlmm>, <0x30 0x00>;
				ocp,irq-gpio = <&tlmm>, <0x4f 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&usb_ocp>, <&sim_gpio>, <&gpio_nc>;
				status = "ok";
			};

			i2c@0 {
				compatible = "i2c-gpio";
				reg = <0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <&fan>;
				gpios = <&tlmm>, <0x08 0x06>, <&tlmm>, <0x09 0x06>;
				i2c-gpio,sda-open-drain;
				i2c-gpio,scl-open-drain;
				i2c-gpio,delay-us = <0x05>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				fancontroller: max31760@50 {
					compatible = "maxim,max31760";
					reg = <0x50>;
					#cooling-cells = <0x02>;
					maxim,vdd-supply = <&pm8008j_l7>;
					regulator-names = "maxim,vdd";
					maxim,vdda-supply = <&pm8008j_l6>;
					maxim,vcca-supply = <&pm8350_s10>;
					maxim,usb_charge_contrl = <&tlmm>, <0x4e 0x00>;
					maxim,dpr_contrl = <&tlmm>, <0x5d 0x00>;
					pinctrl-names = "qupv3_se19_spi_pins";
					pinctrl-1 = <&qupv3_se19_spi_sleep>;
					status = "ok";
					phandle = <0x85>;
				};
			};

			joystick_usb_vbus: joystick_usb_vbus_regulator {
				compatible = "regulator-fixed";
				regulator-name = "joystick_usb_vbus";
				regulator-min-microvolt = <0x4c4b40>;
				regulator-max-microvolt = <0x4c4b40>;
				regulator-enable-ramp-delay = <0x258>;
				gpio = <&pm8350_gpios>, <0x08 0x00>;
				enable-active-high;
				regulator-always-on;
				pinctrl-names = "default";
				pinctrl-0 = <&usb2_vbus_boost_default>;
				phandle = <0x145>;
			};

			thundersoft_straps {
				compatible = "thundersoft,straps";
				sku-gpios = <&tlmm>, <0x03 0x10>, <&tlmm>, <0x06 0x10>, <&tlmm>, <0x07 0x10>;
				board_rev-gpios = <&tlmm>, <0x2d 0x10>, <&tlmm>, <0x32 0x10>, <&tlmm>, <0x33 0x10>;
				pinctrl-names = "default";
				pinctrl-0 = <&sku_straps>, <&board_rev_straps>;
				status = "ok";
			};
		};
	};

