			pm8350_tz {

				cooling-maps {

					pm8350_gpu {
						trip = <&pm8350_trip0>;
						cooling-device = <&msm_gpu>, <0xfffffffe 0xfffffffe>;
					};

					pm8350_cpu4_freq {
						trip = <&pm8350_trip0>;
