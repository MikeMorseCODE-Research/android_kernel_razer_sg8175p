					};

					vbat_cdsp2 {
						trip = <&b_bcl_lvl2>;
						cooling-device = <&cdsp_sw>, <0xfffffffe 0xfffffffe>;
					};
				};
			};

			pm8350c-bcl-lvl0 {
				disable-thermal-zone;

				cooling-maps {

					vph_modem_l3 {
						trip = <&c_bcl_lvl0>;
						cooling-device = <&modem_tj>, <0x03 0x03>;
					};

					vph_gpu0 {
						trip = <&c_bcl_lvl0>;
						cooling-device = <&msm_gpu>, <0x02 0x02>;
					};

					vph_cpu4 {
						trip = <&c_bcl_lvl0>;
						cooling-device = <&cpu4_isolate>, <0x01 0x01>;
					};

					vph_cpu5 {
						trip = <&c_bcl_lvl0>;
						cooling-device = <&cpu5_isolate>, <0x01 0x01>;
					};

					vph_cdsp0 {
						trip = <&c_bcl_lvl0>;
						cooling-device = <&cdsp_sw>, <0x02 0x02>;
					};
				};
			};

			pm8350c-bcl-lvl1 {
				disable-thermal-zone;

				cooling-maps {

					vph_gpu1 {
						trip = <&c_bcl_lvl1>;
						cooling-device = <&msm_gpu>, <0x04 0x04>;
					};

					vph_cpu6 {
						trip = <&c_bcl_lvl1>;
						cooling-device = <&cpu6_isolate>, <0x01 0x01>;
					};

					vph_cpu7 {
						trip = <&c_bcl_lvl1>;
						cooling-device = <&cpu7_isolate>, <0x01 0x01>;
					};

